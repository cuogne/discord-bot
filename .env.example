# for development, set NODE_ENV=development, for production, set NODE_ENV=production
NODE_ENV =

# discord bot token
BOT_TOKEN =
ADMIN_BOT_ID =

# log channel id for command usage logs
LOG_CHANNEL_ID =

# gemini
GEMINI_MODELS =
GEMINI_API_KEY =
GEMINI_API_KEY_FOR_SUMMARY =

# tavily web search for /gemini
TAVILY_API_KEY =

# translation
DEEPL_API_KEY =
DEEPL_API_URL=

# database
MONGO_URI =

BROWSERLESS_API_KEY=
# Proxy dân cư Việt Nam giúp Studocu mở tài liệu; đặt false để dùng kết nối trực tiếp.
BROWSERLESS_RESIDENTIAL_PROXY=true
# Lọc quảng cáo/tracker để giảm dữ liệu qua proxy; đặt false nếu Studocu tải thiếu trang.
BROWSERLESS_BLOCK_ADS=true
