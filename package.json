{
  "name": "bot-discord",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "cừn",
  "license": "ISC",
  "description": "a discord bot built with TypeScript + Bun, many useful features",
  "dependencies": {
    "@google/genai": "^1.38.0",
    "@mozilla/readability": "^0.6.0",
    "@nghiavuive/lunar_date_vi": "^2.0.1",
    "axios": "^1.13.4",
    "cheerio": "^1.2.0",
    "discord.js": "^14.25.1",
    "jsdom": "^29.1.1",
    "mongoose": "^9.1.5",
    "openai": "^6.16.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0"
  }
}
